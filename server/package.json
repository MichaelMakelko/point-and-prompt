{
  "name": "point-and-prompt-server",
  "version": "0.1.0",
  "description": "Claude Code channel that receives element picks and box selections from the point-and-prompt Chrome extension",
  "license": "MIT",
  "author": "Michael Makelko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MichaelMakelko/point-and-prompt.git",
    "directory": "server"
  },
  "homepage": "https://github.com/MichaelMakelko/point-and-prompt#readme",
  "bugs": "https://github.com/MichaelMakelko/point-and-prompt/issues",
  "keywords": [
    "claude-code",
    "claude",
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude-code-channels",
    "chrome-extension",
    "visual-feedback",
    "element-picker",
    "frontend",
    "developer-tools"
  ],
  "type": "module",
  "bin": {
    "point-and-prompt": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc",
    "test": "node --test --experimental-strip-types src/*.test.ts",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
