// Type check for the editor, the tests and `npm run typecheck`. The build uses tsconfig.build.json.
{
  "compilerOptions": {
    "target": "ES2023",
    // No DOM types: this code runs in Node. ES2024.String adds toWellFormed(), which Node 20 already has.
    "lib": ["ES2023", "ES2024.String"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": "src",
    "strict": true,
    "types": ["node"],
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    // The tests run the .ts files directly in Node. These two reject syntax that Node cannot strip.
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "sourceMap": false,
    "noEmit": true
  },
  "include": ["src"]
}
